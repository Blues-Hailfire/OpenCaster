# Original Magic Caster audio/visual media, from uuyyyuu/magic-caster-spellbook:
# keep local.  Tracked exceptions: the spell manifest (spellbook.json) and
# OpenCaster's own logo (media/Logo/).
#   media/          *_video_payoff.mp4, patronus/mishap videos
#   media/sounds/   sfx_<spell>_cast_01..05.mp3
media/*
!media/spellbook.json
!media/Logo/
sounds/
videos/

# Per-user state
progress.json
settings.json
wand_profiles.json
*.tmp

# Python
__pycache__/
*.pyc

# Setup / builds
.venv/
build/
dist/
